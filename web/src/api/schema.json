    "DecisionEvent": {
      "description": "One row of the append-only decision history (`decision_events`).\n\nWritten in the same transaction as the decision it records, never updated or deleted.\n`from_*` is what was in force before (the previous decision's `decided_verdict`, or the\nmodel's verdict and basis for the first decision), `to_*` what is in force after.",
      "properties": {
        "action": {
          "enum": [
            "accept",
            "override",
            "dismiss"
          ],
          "title": "Action",
          "type": "string"
        },
        "agent_version": {
          "title": "Agent Version",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "authenticated": {
          "default": false,
          "title": "Authenticated",
          "type": "boolean"
        },
        "decided_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decided By"
        },
        "event_id": {
          "title": "Event Id",
          "type": "integer"
        },
        "from_basis": {
          "items": {
            "type": "string"
          },
