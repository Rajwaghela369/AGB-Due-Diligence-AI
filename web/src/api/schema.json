{
  "$defs": {
    "Agreement": {
      "description": "Lawyer agreement for one agent version, over every review judged by it.",
      "properties": {
        "agent_version": {
          "title": "Agent Version",
          "type": "string"
        },
        "by_verdict": {
          "$ref": "#/$defs/AgreementByVerdict"
        },
        "decided": {
          "default": 0,
          "title": "Decided",
          "type": "integer"
        },
        "dismissed": {
          "default": 0,
          "title": "Dismissed",
          "type": "integer"
        },
        "kept": {
          "default": 0,
          "title": "Kept",
          "type": "integer"
        },
        "last_decided_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Decided At"
        },
        "overridden": {
          "default": 0,
          "title": "Overridden",
          "type": "integer"
        },
        "rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate"
        }
      },
      "required": [
        "agent_version"
      ],
      "title": "Agreement",
      "type": "object"
    },
    "AgreementByVerdict": {
      "description": "The same figures per model verdict: `potentially_void.rate` is void precision as the\nlawyer sees it.",
      "properties": {
        "potentially_void": {
          "$ref": "#/$defs/AgreementCounts"
        },
        "uncertain": {
          "$ref": "#/$defs/AgreementCounts"
        },
        "valid": {
          "$ref": "#/$defs/AgreementCounts"
        }
      },
      "title": "AgreementByVerdict",
      "type": "object"
    },
    "AgreementCounts": {
      "description": "Lawyer agreement over current decisions; `decided = kept + overridden + dismissed`.",
      "properties": {
        "decided": {
          "default": 0,
          "title": "Decided",
          "type": "integer"
        },
        "dismissed": {
          "default": 0,
          "title": "Dismissed",
          "type": "integer"
        },
        "kept": {
          "default": 0,
          "title": "Kept",
          "type": "integer"
        },
        "overridden": {
          "default": 0,
          "title": "Overridden",
          "type": "integer"
        },
        "rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate"
        }
      },
      "title": "AgreementCounts",
      "type": "object"
    },
    "AgreementOut": {
      "description": "`GET /metrics/agreement`: lawyer agreement for one agent version.",
      "properties": {
        "agreement": {
          "$ref": "#/$defs/Agreement"
        },
        "current": {
