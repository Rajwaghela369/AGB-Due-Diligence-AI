          "type": "array"
        },
        "from_verdict": {
          "anyOf": [
            {
              "enum": [
                "valid",
                "potentially_void",
                "uncertain"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Verdict"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "position": {
          "title": "Position",
          "type": "integer"
        },
        "previous_action": {
          "anyOf": [
            {
              "enum": [
                "accept",
                "override",
                "dismiss"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Action"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "review_id": {
          "title": "Review Id",
          "type": "string"
        },
        "to_basis": {
          "items": {
            "type": "string"
          },
          "title": "To Basis",
          "type": "array"
        },
        "to_verdict": {
          "anyOf": [
            {
              "enum": [
                "valid",
                "potentially_void",
                "uncertain"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Verdict"
