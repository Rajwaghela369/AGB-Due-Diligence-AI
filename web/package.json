    "globals": "17.4.0",
    "jsdom": "31.0.1",
    "json-schema-to-typescript": "16.0.0",
    "msw": "3.0.6",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
