    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fast-json-patch": "3.1.1",
    "i18next": "27.1.3",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hotkeys-hook": "5.4.0",
    "react-i18next": "18.0.2",
    "react-router-dom": "7.18.5",
    "tailwind-merge": "3.7.0",
    "zustand": "5.1.0"
