{
  "name": "agb-check-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "gen:api": "node scripts/generate-api.mjs",
