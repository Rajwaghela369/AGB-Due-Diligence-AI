# Copy to .env and fill in. Never commit .env.

# --- LLM / embeddings (OpenAI) ---
OPENAI_API_KEY=

# --- Qdrant Cloud (vector database) ---
QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io:6333
QDRANT_API_KEY=...

# --- Prefect Cloud (orchestration + run observability) ---
# Set by `prefect cloud login`; listed here for reference.
PREFECT_API_URL=https://api.prefect.cloud/api/accounts/<acct>/workspaces/<ws>
PREFECT_API_KEY=pnu_...

# --- Langfuse (Cloud, EU region) ---
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Optional: HuggingFace, only if a dataset needs auth ---
# HF_TOKEN=hf_...

# --- Local paths (defaults are fine) ---
# AGB_DATA_DIR=data
# AGB_STORES_DIR=stores
# AGB_REPORTS_DIR=reports
