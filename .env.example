# Copy to .env and fill in. Never commit .env.

# --- LLM (Gemini) ---
# Required by the agent: the judge (Decisions API) and the German explanation.
# configs/app.yaml names the models.
GEMINI_API_KEY=

# --- LLM (Anthropic, optional) ---
# Only needed if a config points a model at Anthropic again.
ANTHROPIC_API_KEY=

# --- Embeddings (Jina) ---
# Required by the agent: topic routing and retrieval queries.
JINA_API_KEY=
# --- Qdrant Cloud (vector database) ---
QDRANT_URL=https://8e461909-1347-49d1-8c8e-59b72f389034.eu-central-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=

# --- Neon Postgres (clause table, later verdicts) ---
# Use the POOLED connection string from the Neon dashboard, EU region.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/agb_check?sslmode=require

# --- Prefect Cloud (orchestration + run observability) ---
# Set by `prefect cloud login`; listed here for reference.
PREFECT_API_URL=https://api.prefect.cloud/api/accounts/<acct>/workspaces/<ws>
PREFECT_API_KEY=

# --- Langfuse (Cloud, EU region) ---
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# --- HuggingFace (optional) ---
# Leave empty for anonymous access to the public laws dataset.
# A read-scoped token is enough; it is passed explicitly, not exported.
HF_TOKEN=

# --- Gotenberg (DOCX to PDF conversion) ---
# `make api` on the host uses the loopback port of the compose service. Compose overrides
# this to http://gotenberg:3000 inside the network.
GOTENBERG_URL=http://localhost:3000

# --- Neon Managed Better Auth (test branch) ---
VITE_NEON_AUTH_URL=https://ep-morning-bread-b9txgrv6.neonauth.c-7.eu-central-1.aws.neon.tech/neondb/auth
# Keep false until the backend OIDC values below are configured and Neon Console trusts
# the local frontend origin. The existing auth-disabled behavior remains the default.
VITE_NEON_AUTH_ENABLED=false
# Backend auth switch; leave false for the existing local auth-disabled mode.
AGB_AUTH_ENABLED=false
# Backend OIDC values: obtain the issuer, JWT audience, and JWKS URL from Neon Console.
# Do not guess the audience; the API rejects tokens for another audience.
NEON_AUTH_ISSUER=
NEON_AUTH_AUDIENCE=
NEON_AUTH_JWKS_URI=

# --- S3-compatible file storage ---
# Standard AWS-compatible names are used for Neon Object Storage. Do not put credentials
# in configs/app.yaml. The bucket remains configured there. S3_* aliases are supported for
# older deployments. No defaults: the app refuses to start until both credentials are set.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1

# --- Logging ---
# `json` writes one JSON object per line. The API always logs JSON; this switches the
# pipelines and evals as well. Leave empty for the human-readable format.
LOG_FORMAT=

# --- Local paths (defaults are fine) ---
# AGB_DATA_DIR=data
# AGB_REPORTS_DIR=reports

# Development login (Phase 9, 9.E): the Keycloak admin console, only with
# `docker compose --profile auth up keycloak`. Test users are in configs/keycloak/.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
