{
  "realm": "agb-check",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "agb-user", "description": "Reviews own documents" },
      { "name": "agb-admin", "description": "May read and delete any owner's documents" }
    ]
  },
  "clients": [
    {
      "clientId": "agb-check-web",
      "name": "AGB-Check web (development)",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5173/*", "http://localhost:5180/*"],
      "webOrigins": ["http://localhost:5173", "http://localhost:5180"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "+" },
      "protocolMappers": [
        {
          "name": "audience agb-check-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "agb-check-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "anna",
      "firstName": "Anna",
      "lastName": "Müller",
      "email": "anna@example.test",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "anna-dev-only", "temporary": false }],
      "realmRoles": ["agb-user"]
    },
    {
      "username": "ben",
      "firstName": "Ben",
      "lastName": "Schmidt",
      "email": "ben@example.test",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "ben-dev-only", "temporary": false }],
      "realmRoles": ["agb-user", "agb-admin"]
    }
  ]
}
