# Keep the build context small and free of host state: no secrets, no host virtualenv,
# no frontend build output, no raw or interim data.
.env
.env.*
!.env.example
.git
.github
.venv
venv
**/__pycache__
**/*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
web
docs
reports
scripts
tests
briefs
stores
data/raw
data/interim
data/gold
Dockerfile
docker-compose.yml
.dockerignore
